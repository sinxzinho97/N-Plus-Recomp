+   gr->base.ops.get_buffer_color_info = aimapper_get_buffer_color_info;
+   gr->base.ops.destroy = destroy;
+
+   mesa_logi("N+ Turnip V6: Using IMapper v5 stable-C API (%s)", via);
+
+   return &gr->base;
+}
