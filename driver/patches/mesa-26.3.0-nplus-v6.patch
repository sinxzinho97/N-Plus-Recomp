+/* SPDX-License-Identifier: MIT
+ * Private to the Turnip Android WSI code. This build uses the NDK only.
+ */
+#include <android/hardware_buffer.h>
+#include <dlfcn.h>
+#include "tu_knl.h"
+#include "util/log.h"
+#include "util/u_gralloc/u_gralloc.h"
+
+namespace {
+/* Public prefix of the frozen Android graphics mapper stable-C v5 ABI:
+ * hardware/interfaces/graphics/mapper/stable-c/include/android/hardware/graphics/mapper/IMapper.h.
+ * The NDK sysroot omits this platform header. No vendor handle fields are used.
+ */
+struct mapper_v5_prefix {
+   alignas(max_align_t) uint32_t version;
+   int32_t (*import_buffer)(const native_handle_t *, buffer_handle_t *);
+   int32_t (*free_buffer)(buffer_handle_t);
+   void (*get_transport_size)();
+   void (*lock)();
+   void (*unlock)();
+   void (*flush_locked_buffer)();
+   void (*reread_locked_buffer)();
+   void (*get_metadata)();
+   int32_t (*get_standard_metadata)(buffer_handle_t, int64_t, void *, size_t);
+};
+
+const mapper_v5_prefix *
+load_display_mapper()
+{
+   void *binder = dlopen("libbinder_ndk.so", RTLD_NOW | RTLD_LOCAL);
+   if (!binder)
+      return nullptr;
+
+   using visit_fn = void (*)(const char *, void *, void (*)(const char *, void *));
+   using open_fn = void *(*)(const char *, const char *, int);
+   auto visit = reinterpret_cast<visit_fn>(dlsym(binder, "AServiceManager_forEachDeclaredInstance"));
+   auto open = reinterpret_cast<open_fn>(dlsym(binder, "AServiceManager_openDeclaredPassthroughHal"));
+   struct instance_info {
+      char name[128] = {};
+      unsigned count = 0;
+   } instance;
+   if (visit && open) {
+      visit("mapper", &instance, [](const char *name, void *ctx) {
+         auto *info = static_cast<instance_info *>(ctx);
+         info->count++;
+         if (info->count == 1 && name && strlen(name) < sizeof(info->name))
+            memcpy(info->name, name, strlen(name) + 1);
+      });
+   }
+
+   /* Ask Android to open only a single, already loaded, declared HAL. */
+   void *module = instance.count == 1 && instance.name[0]
+      ? open("mapper", instance.name, RTLD_NOLOAD | RTLD_NOW | RTLD_LOCAL) : nullptr;
+   dlclose(binder);
+   if (!module)
+      return nullptr;
+
+   using load_fn = int32_t (*)(const mapper_v5_prefix **);
+   auto load = reinterpret_cast<load_fn>(dlsym(module, "AIMapper_loadIMapper"));
+   const mapper_v5_prefix *mapper = nullptr;
+   if (!load || load(&mapper) != 0 || !mapper || mapper->version < 5 ||
+       !mapper->import_buffer || !mapper->free_buffer || !mapper->get_standard_metadata) {
+      dlclose(module);
+      return nullptr;
+   }
+   /* The function table belongs to the HAL. Keep this reference for its lifetime. */
+   return mapper;
+}
+
+/* AOSP standard metadata encoding. Every field is packed without padding.
+ * Only fixed-size responses for this single-plane RGBA surface are accepted.
+ */
+struct metadata_reader {
+   uint8_t bytes[1024];
+   size_t pos = 0, size = 0;
+
+   bool word(uint64_t &out) {
+      if (size - pos < sizeof(out))
+         return false;
+      memcpy(&out, bytes + pos, sizeof(out));
+      pos += sizeof(out);
+      return true;
+   }
+
+   bool label(const char *expected = nullptr) {
+      uint64_t len;
+      if (!word(len) || len > size - pos ||
+          (expected && (len != strlen(expected) || memcmp(bytes + pos, expected, len))))
+         return false;
+      pos += len;
+      return true;
+   }
+
+   bool fetch(const mapper_v5_prefix *mapper, buffer_handle_t h, int64_t type) {
+      int32_t n = mapper->get_standard_metadata(h, type, bytes, sizeof(bytes));
+      if (n <= 0 || (size_t)n > sizeof(bytes))
+         return false;
+      pos = 0;
+      size = n;
+      uint64_t actual_type;
+      return label("android.hardware.graphics.common.StandardMetadataType") &&
+             word(actual_type) && actual_type == (uint64_t)type;
+   }
+};
+
+struct plane_info {
+   uint64_t offset, pitch;
+};
+
+bool
+read_plane(metadata_reader &r, plane_info &p)
+{
+   uint64_t count, ignored;
+   if (!r.word(count) || count > 16)
+      return false;
+   for (unsigned i = 0; i < count; ++i) {
+      if (!r.label() || !r.word(ignored) || !r.word(ignored) || !r.word(ignored))
+         return false;
+   }
+   return r.word(p.offset) && r.word(ignored) && r.word(p.pitch) &&
+          r.word(ignored) && r.word(ignored) && r.word(ignored) &&
+          r.word(ignored) && r.word(ignored);
+}
+
+uint64_t
+read_display_modifier(const mapper_v5_prefix *mapper, buffer_handle_t handle,
+                      const tu_device *dev, const VkImageCreateInfo *ci, uint32_t pitch)
+{
+   constexpr int64_t pixel_format_modifier = 8, allocation_size = 10,
+                     compression = 12, plane_layouts = 15;
+   metadata_reader r;
+   uint64_t modifier, bytes, value, plane_count;
+   if (!r.fetch(mapper, handle, pixel_format_modifier) || !r.word(modifier) || r.pos != r.size ||
+       !r.fetch(mapper, handle, allocation_size) || !r.word(bytes) || r.pos != r.size ||
+       !r.fetch(mapper, handle, compression))
+      return DRM_FORMAT_MOD_INVALID;
+
+   /* Qualcomm declares the (namespace, value) pair in QtiGralloc.h and
+    * QtiGrallocMetadata.h. Unknown compression types do not imply UBWC.
+    */
+   size_t payload = r.pos;
+   bool compressed = r.label("QTI") && r.word(value) && value == 20001 && r.pos == r.size;
+   if (compressed) {
+      /* Some QTI mappers use zero as a placeholder even for UBWC. Only
+       * accept it if both plane geometries below exactly match Mesa's FDL. */
+      if (modifier != DRM_FORMAT_MOD_QCOM_COMPRESSED && modifier != DRM_FORMAT_MOD_INVALID &&
+          modifier != DRM_FORMAT_MOD_LINEAR)
+         return DRM_FORMAT_MOD_INVALID;
+   } else {
+      r.pos = payload;
+      if (!r.label("android.hardware.graphics.common.Compression") ||
+          !r.word(value) || value != 0 || r.pos != r.size || modifier != DRM_FORMAT_MOD_LINEAR)
+         return DRM_FORMAT_MOD_INVALID;
+   }
+   if (!r.fetch(mapper, handle, plane_layouts) || !r.word(plane_count) ||
+       plane_count != (compressed ? 2u : 1u))
+      return DRM_FORMAT_MOD_INVALID;
+   plane_info planes[2];
+   for (unsigned i = 0; i < plane_count; ++i)
+      if (!read_plane(r, planes[i]))
+         return DRM_FORMAT_MOD_INVALID;
+   if (r.pos != r.size || pitch < uint64_t(ci->extent.width) * 4)
+      return DRM_FORMAT_MOD_INVALID;
+
+   struct fdl_layout layout = {};
+   const struct fdl_explicit_layout storage = { .offset = 0, .pitch = pitch };
+   struct fdl_image_params params = {};
+   params.format = vk_format_to_pipe_format(ci->format);
+   params.nr_samples = params.depth0 = params.mip_levels = params.array_size = 1;
+   params.width0 = ci->extent.width;
+   params.height0 = ci->extent.height;
+   params.tile_mode = compressed ? TILE6_3 : TILE6_LINEAR;
+   params.ubwc = params.force_ubwc = compressed;
+   if (!fdl6_layout_image(&layout, &dev->physical_device->dev_info, &params, &storage) ||
+       layout.size > bytes || layout.ubwc != compressed)
+      return DRM_FORMAT_MOD_INVALID;
+
+   /* Accept exactly the row pitch and byte offsets that Turnip will use.
+    * Vendors may expose the metadata plane before or after the color plane.
+    */
+   unsigned color = compressed && planes[0].offset == 0 ? 1 : 0;
+   if (planes[color].offset != layout.slices[0].offset || planes[color].pitch != fdl_pitch(&layout, 0))
+      return DRM_FORMAT_MOD_INVALID;
+   if (compressed && (!planes[color].offset || planes[1 - color].offset != 0 ||
+                      planes[1 - color].offset != layout.ubwc_slices[0].offset ||
+                      planes[1 - color].pitch != fdl_ubwc_pitch(&layout, 0)))
+      return DRM_FORMAT_MOD_INVALID;
+   return compressed ? DRM_FORMAT_MOD_QCOM_COMPRESSED : DRM_FORMAT_MOD_LINEAR;
+}
+
+bool
+uses_recomp_display_layout(const VkImageCreateInfo *ci)
+{
+   const VkImageCompressionControlEXT *control =
+      vk_find_struct_const(ci->pNext, IMAGE_COMPRESSION_CONTROL_EXT);
+   return ci->tiling == VK_IMAGE_TILING_OPTIMAL && ci->flags == 0 &&
+          ci->usage == (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT) &&
+          (!control || control->flags == VK_IMAGE_COMPRESSION_DEFAULT_EXT) &&
+          !vk_find_struct_const(ci->pNext, IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT) &&
+          !vk_find_struct_const(ci->pNext, IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT) &&
+          !vk_find_struct_const(ci->pNext, IMAGE_CREATE_FLAGS_2_CREATE_INFO_KHR) &&
+          !vk_find_struct_const(ci->pNext, IMAGE_USAGE_FLAGS_2_CREATE_INFO_KHR);
+}
+
+void
+recover_display_modifier(const tu_device *dev, const VkImageCreateInfo *ci,
+                         VkImageDrmFormatModifierExplicitCreateInfoEXT &eci)
+{
+   const tu_physical_device *gpu = dev->physical_device;
+   if (eci.drmFormatModifier != DRM_FORMAT_MOD_INVALID ||
+       (uint32_t(gpu->dev_id.chip_id) != 0x44050000 && uint32_t(gpu->dev_id.chip_id) != 0x44050001) ||
+       strcmp(gpu->instance->knl->name, "kgsl") != 0 ||
+       (ci->format != VK_FORMAT_R8G8B8A8_UNORM && ci->format != VK_FORMAT_R8G8B8A8_SRGB) ||
+       ci->imageType != VK_IMAGE_TYPE_2D || ci->mipLevels != 1 || ci->arrayLayers != 1 ||
+       ci->samples != VK_SAMPLE_COUNT_1_BIT || ci->extent.depth != 1 ||
+       eci.drmFormatModifierPlaneCount != 1 || eci.pPlaneLayouts[0].offset ||
+       !eci.pPlaneLayouts[0].rowPitch || eci.pPlaneLayouts[0].rowPitch > UINT32_MAX ||
+       u_gralloc_get_type(vk_android_get_ugralloc()) != U_GRALLOC_TYPE_FALLBACK)
+      return;
+
+   const VkNativeBufferANDROID *anb = vk_find_struct_const(ci->pNext, NATIVE_BUFFER_ANDROID);
+   if (!anb || !anb->handle ||
+       (anb->format != AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM &&
+        anb->format != AHARDWAREBUFFER_FORMAT_R8G8B8X8_UNORM))
+      return;
+   static const mapper_v5_prefix *mapper = load_display_mapper();
+   if (!mapper)
+      return;
+   buffer_handle_t imported = nullptr;
+   if (mapper->import_buffer(anb->handle, &imported) != 0 || !imported)
+      return;
+   uint64_t recovered = read_display_modifier(mapper, imported, dev, ci, eci.pPlaneLayouts[0].rowPitch);
+   mapper->free_buffer(imported);
+   if (recovered != DRM_FORMAT_MOD_INVALID) {
+      eci.drmFormatModifier = recovered;
+      /* Each confirmed layout gets a single diagnostic per process. */
+      static int reported[2] = {};
+      const bool ubwc = recovered == DRM_FORMAT_MOD_QCOM_COMPRESSED;
+      int *once = &reported[ubwc ? 1 : 0];
+      if (p_atomic_cmpxchg(once, 0, 1) == 0)
+         mesa_logi("N+ Turnip V6: IMapper5 confirmed RGBA display buffer layout %s",
+                   ubwc ? "UBWC" : "LINEAR");
+   }
+}
+} /* anonymous namespace */
