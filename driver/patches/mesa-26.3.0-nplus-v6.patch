+
+/*
+ * IMapper5 stable-C backend, reached via Android's NDK passthrough loader
+ * (libbinder_ndk.so) or the SP-HAL loader (libvndksupport.so).
+ *
+ * Adapted from Leb-Sun's u_gralloc_aimapper backend for Mesa builds with
+ * -Dandroid-stub=true, hardened for Samsung One UI / Android 15-16 SELinux
+ * policies, raw/unimported handles, and both QTI UBWC plane orderings.
+ */
+
+#include <dirent.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <stdalign.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "drm-uapi/drm_fourcc.h"
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/u_atomic.h"
+#include "util/u_memory.h"
+
+#include "u_gralloc_internal.h"
+
+typedef struct AIMapperV5 {
+   int32_t (*importBuffer)(const native_handle_t *handle,
+                           const native_handle_t **outBufferHandle);
+   int32_t (*freeBuffer)(const native_handle_t *buffer);
+   void *getTransportSize;
+   void *lock;
+   void *unlock;
+   void *flushLockedBuffer;
+   void *rereadLockedBuffer;
+   void *getMetadata;
+   int32_t (*getStandardMetadata)(const native_handle_t *buffer,
+                                  int64_t standardMetadataType, void *destBuffer,
+                                  size_t destBufferSize);
+   void *setMetadata;
+   void *setStandardMetadata;
+   void *listSupportedMetadataTypes;
+   void *dumpBuffer;
+   void *dumpAllBuffers;
+   void *getReservedRegion;
+} AIMapperV5;
+
+typedef struct AIMapper {
+   alignas(alignof(max_align_t)) uint32_t version;
+   AIMapperV5 v5;
+} AIMapper;
+
+#define AIMAPPER_VERSION_5 5
+
+/* StandardMetadataType.aidl */
+#define SMT_LAYER_COUNT           5
+#define SMT_PIXEL_FORMAT_FOURCC   7
+#define SMT_PIXEL_FORMAT_MODIFIER 8
+#define SMT_ALLOCATION_SIZE       10
+#define SMT_COMPRESSION           12
+#define SMT_CHROMA_SITING         14
+#define SMT_PLANE_LAYOUTS         15
+#define SMT_DATASPACE             17
+
+/* Dataspace bit fields */
+#define DS_STANDARD_MASK      (63u << 16)
+#define DS_STANDARD_BT709     (1u << 16)
+#define DS_STANDARD_BT2020    (6u << 16)
+#define DS_STANDARD_BT2020_CL (7u << 16)
+#define DS_RANGE_MASK         (7u << 27)
+#define DS_RANGE_FULL         (1u << 27)
+
+/* ChromaSiting.aidl */
+#define CHROMA_SITING_COSITED_HORIZONTAL 3
+#define CHROMA_SITING_COSITED_VERTICAL   4
+#define CHROMA_SITING_COSITED_BOTH       5
+
+struct aimapper_gralloc {
+   struct u_gralloc base;
+   void *mapper_lib;
+   AIMapper *mapper;
+};
+
+struct md_reader {
+   const uint8_t *p;
+   const uint8_t *end;
+   bool ok;
+};
+
+static bool
+md_take(struct md_reader *r, void *dst, size_t n)
+{
+   if (!r->ok || (size_t)(r->end - r->p) < n) {
+      r->ok = false;
+      return false;
+   }
+   if (dst)
+      memcpy(dst, r->p, n);
+   r->p += n;
+   return true;
+}
+
+static int64_t
+md_i64(struct md_reader *r)
+{
+   int64_t v = 0;
+   md_take(r, &v, sizeof(v));
+   return v;
+}
+
+static void
+md_take_str(struct md_reader *r, char *out, size_t out_size)
+{
+   int64_t len = md_i64(r);
+   if (len < 0 || len > (r->end - r->p)) {
+      r->ok = false;
+      if (out_size)
+         out[0] = '\0';
+      return;
+   }
+   size_t copy = (size_t)len < out_size - 1 ? (size_t)len : out_size - 1;
+   if (out_size) {
+      memcpy(out, r->p, copy);
+      out[copy] = '\0';
+   }
+   md_take(r, NULL, (size_t)len);
+}
+
+static void
+md_skip_str(struct md_reader *r)
+{
+   int64_t len = md_i64(r);
+   if (len < 0 || len > (r->end - r->p)) {
+      r->ok = false;
+      return;
+   }
+   md_take(r, NULL, (size_t)len);
+}
+
+static bool
+md_header(struct md_reader *r, int64_t expect_type)
+{
+   md_skip_str(r);
+   return r->ok && md_i64(r) == expect_type && r->ok;
+}
+
+static int32_t
+md_fetch(struct aimapper_gralloc *gr, const native_handle_t *handle,
+         int64_t type, void *buf, size_t buf_size)
+{
+   int32_t n = gr->mapper->v5.getStandardMetadata(handle, type, buf, buf_size);
+   if (n < 0 || (size_t)n > buf_size)
+      return -1;
+   return n;
+}
+
+static bool
+md_scalar(struct aimapper_gralloc *gr, const native_handle_t *handle,
+          int64_t type, void *out, size_t out_size)
+{
+   uint8_t buf[160];
+   int32_t n = md_fetch(gr, handle, type, buf, sizeof(buf));
+   if (n < 0)
+      return false;
+
+   struct md_reader r = {buf, buf + n, true};
+   if (!md_header(&r, type))
+      return false;
+
+   return md_take(&r, out, out_size);
+}
+
+static bool
+md_compression(struct aimapper_gralloc *gr, const native_handle_t *handle,
+               char *name, size_t name_size, int64_t *value)
+{
+   uint8_t buf[256];
+   int32_t n = md_fetch(gr, handle, SMT_COMPRESSION, buf, sizeof(buf));
+   if (n < 0)
+      return false;
+
+   struct md_reader r = {buf, buf + n, true};
+   if (!md_header(&r, SMT_COMPRESSION))
+      return false;
+
+   md_take_str(&r, name, name_size);
+   *value = md_i64(&r);
+
+   return r.ok;
+}
+
+static int
+aimapper_get_buffer_basic_info(struct u_gralloc *gralloc,
+                               struct u_gralloc_buffer_handle *hnd,
+                               struct u_gralloc_buffer_basic_info *out)
+{
+   struct aimapper_gralloc *gr = (struct aimapper_gralloc *)gralloc;
+
+   if (!hnd->handle) {
+      mesa_logw("aimapper: FAIL null handle");
+      return -EINVAL;
+   }
+
+   const native_handle_t *query_hnd = hnd->handle;
+   const native_handle_t *imported = NULL;
+   uint8_t *buf = NULL;
+   int ret = -EINVAL;
+   int32_t got = 0;
+   int64_t num_planes = 0;
+   struct md_reader r = {NULL, NULL, false};
+
+   /* Probe PLANE_LAYOUTS first: already-imported GraphicBuffer handles answer
+    * directly; raw external handles may need importBuffer() on QTI IMapper5.
+    */
+   int32_t need = gr->mapper->v5.getStandardMetadata(query_hnd,
+                                                     SMT_PLANE_LAYOUTS, NULL, 0);
+   if (need <= 0 && gr->mapper->v5.importBuffer && gr->mapper->v5.freeBuffer) {
+      if (gr->mapper->v5.importBuffer(hnd->handle, &imported) == 0 && imported) {
+         query_hnd = imported;
+         need = gr->mapper->v5.getStandardMetadata(query_hnd,
+                                                   SMT_PLANE_LAYOUTS, NULL, 0);
+      }
+   }
+   if (need <= 0) {
+      mesa_logw("aimapper: PLANE_LAYOUTS unavailable (%d)", need);
+      goto out_free;
+   }
+
+   uint32_t fourcc = 0;
+   if (!md_scalar(gr, query_hnd, SMT_PIXEL_FORMAT_FOURCC, &fourcc,
+                  sizeof(fourcc)) || fourcc == 0) {
+      int derived = get_fourcc_from_hal_format(hnd->hal_format);
+      if (derived == -1) {
+         mesa_logw("aimapper: no fourcc from mapper and none for hal_format %d",
+                   hnd->hal_format);
+         goto out_free;
+      }
+      fourcc = (uint32_t)derived;
+   }
+   out->drm_fourcc = fourcc;
+
+   uint64_t modifier = 0;
+   if (md_scalar(gr, query_hnd, SMT_PIXEL_FORMAT_MODIFIER, &modifier,
+                 sizeof(modifier)))
+      out->modifier = modifier;
+   else
+      out->modifier = DRM_FORMAT_MOD_INVALID;
+
+   buf = MALLOC(need);
+   if (!buf) {
+      mesa_logw("aimapper: FAIL malloc %d", need);
+      ret = -ENOMEM;
+      goto out_free;
+   }
+
+   got = md_fetch(gr, query_hnd, SMT_PLANE_LAYOUTS, buf, need);
+   if (got < 0) {
+      mesa_logw("aimapper: FAIL PLANE_LAYOUTS fetch (need=%d got=%d)", need, got);
+      goto out_free;
+   }
+
+   r = (struct md_reader){buf, buf + got, true};
+   if (!md_header(&r, SMT_PLANE_LAYOUTS)) {
+      mesa_logw("aimapper: FAIL PLANE_LAYOUTS header framing (%d bytes)", got);
+      goto out_free;
+   }
+
+   num_planes = md_i64(&r);
+   if (!r.ok || num_planes <= 0 || num_planes > 4) {
+      mesa_logw("aimapper: implausible plane count %" PRId64, num_planes);
+      goto out_free;
+   }
+
+   for (int64_t i = 0; i < num_planes && r.ok; i++) {
+      int64_t num_components = md_i64(&r);
+      if (!r.ok || num_components < 0 || num_components > 16) {
+         mesa_logw("aimapper: FAIL plane %" PRId64 " component count %" PRId64
+                   " (ok=%d)", i, num_components, (int)r.ok);
+         goto out_free;
+      }
+
+      for (int64_t j = 0; j < num_components && r.ok; j++) {
+         md_skip_str(&r);   /* component type name */
+         md_i64(&r);        /* component type value */
+         md_i64(&r);        /* offsetInBits */
+         md_i64(&r);        /* sizeInBits */
+      }
+
+      int64_t offset_bytes = md_i64(&r);
+      md_i64(&r);                            /* sampleIncrementInBits */
+      int64_t stride_bytes = md_i64(&r);
+      md_i64(&r);                            /* widthInSamples */
+      md_i64(&r);                            /* heightInSamples */
+      md_i64(&r);                            /* totalSizeInBytes */
+      md_i64(&r);                            /* horizontalSubsampling */
+      md_i64(&r);                            /* verticalSubsampling */
+
+      if (!r.ok) {
+         mesa_logw("aimapper: FAIL plane %" PRId64 " field decode ran short", i);
+         goto out_free;
+      }
+
+      out->offsets[i] = (int)offset_bytes;
+      out->strides[i] = (int)stride_bytes;
+   }
+
+   out->num_planes = (int)num_planes;
+
+   char compr_name[128] = "";
+   int64_t compr_value = 0;
+   bool have_compr = md_compression(gr, query_hnd, compr_name,
+                                    sizeof(compr_name), &compr_value);
+
+   bool compr_says_compressed =
+      have_compr &&
+      (compr_value != 0 ||
+       strcmp(compr_name,
+              "android.hardware.graphics.common.Compression") != 0);
+
+   bool mod_says_ubwc = (out->modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED);
+
+   /* QTI IMapper5 exposes single-plane RGB UBWC as 2 planes (data + metadata)
+    * while sometimes reporting modifier=LINEAR. Vendors may place the metadata
+    * plane at index 0 or index 1; always keep the color plane's stride.
+    */
+   bool is_yuv = is_hal_format_yuv(hnd->hal_format);
+   bool layout_says_ubwc =
+      !is_yuv && num_planes == 2 &&
+      ((out->offsets[1] == 0 && out->offsets[0] > 0 && out->strides[1] < out->strides[0]) ||
+       (out->offsets[0] == 0 && out->offsets[1] > 0 && out->strides[0] < out->strides[1]));
+
+   if (!is_yuv && num_planes <= 2 &&
+       (compr_says_compressed || mod_says_ubwc || layout_says_ubwc)) {
+      int color_plane =
+         (num_planes == 2 && out->offsets[0] == 0 && out->offsets[1] > 0) ? 1 : 0;
+      int meta_plane = 1 - color_plane;
+
+      static int logged_ubwc = 0;
+      if (p_atomic_cmpxchg(&logged_ubwc, 0, 1) == 0) {
+         mesa_logi("aimapper: compressed layout detected via %s "
+                   "(color plane %d stride=%d @%d, meta plane %d stride=%d @%d) "
+                   "- collapsing to 1 UBWC plane",
+                   compr_says_compressed ? "COMPRESSION metadata"
+                   : mod_says_ubwc ? "DRM modifier" : "plane signature",
+                   color_plane, out->strides[color_plane], out->offsets[color_plane],
+                   num_planes == 2 ? meta_plane : -1,
+                   num_planes == 2 ? out->strides[meta_plane] : 0,
+                   num_planes == 2 ? out->offsets[meta_plane] : 0);
+      }
+
+      out->strides[0] = out->strides[color_plane];
+      out->offsets[0] = 0;
+      out->offsets[1] = 0;
+      out->strides[1] = 0;
+      out->num_planes = 1;
+      num_planes = 1;
+      out->modifier = DRM_FORMAT_MOD_QCOM_COMPRESSED;
+   } else if (have_compr && !compr_says_compressed &&
+              out->modifier == DRM_FORMAT_MOD_INVALID) {
+      out->modifier = DRM_FORMAT_MOD_LINEAR;
+   }
+
+   if (hnd->handle->numFds == 0) {
+      mesa_logw("aimapper: FAIL handle has no fds");
+      goto out_free;
+   }
+
+   if (hnd->handle->numFds >= num_planes) {
+      for (int64_t i = 0; i < num_planes; i++)
+         out->fds[i] = hnd->handle->data[i];
+   } else {
+      for (int64_t i = 0; i < num_planes; i++)
+         out->fds[i] = hnd->handle->data[0];
+   }
+
+   uint64_t layer_count = 0;
+   if (md_scalar(gr, query_hnd, SMT_LAYER_COUNT, &layer_count,
+                 sizeof(layer_count)))
+      out->layer_count = layer_count;
+
+   uint64_t alloc_size = 0;
+   if (md_scalar(gr, query_hnd, SMT_ALLOCATION_SIZE, &alloc_size,
+                 sizeof(alloc_size)))
+      out->alloc_size = alloc_size;
+
+   ret = 0;
+
+out_free:
+   FREE(buf);
+   if (imported)
+      gr->mapper->v5.freeBuffer(imported);
+   return ret;
+}
+
+static int
+aimapper_get_buffer_color_info(struct u_gralloc *gralloc,
+                               struct u_gralloc_buffer_handle *hnd,
+                               struct u_gralloc_buffer_color_info *out)
+{
+   struct aimapper_gralloc *gr = (struct aimapper_gralloc *)gralloc;
+
+   if (!hnd->handle)
+      return -EINVAL;
+
+   out->yuv_color_space = __DRI_YUV_COLOR_SPACE_ITU_REC601;
+   out->sample_range = __DRI_YUV_NARROW_RANGE;
+   out->horizontal_siting = __DRI_YUV_CHROMA_SITING_0_5;
+   out->vertical_siting = __DRI_YUV_CHROMA_SITING_0_5;
+
+   const native_handle_t *query_hnd = hnd->handle;
+   const native_handle_t *imported = NULL;
+   uint32_t dataspace = 0;
+   bool have_ds = md_scalar(gr, query_hnd, SMT_DATASPACE, &dataspace, sizeof(dataspace));
+   if (!have_ds && gr->mapper->v5.importBuffer && gr->mapper->v5.freeBuffer) {
+      if (gr->mapper->v5.importBuffer(hnd->handle, &imported) == 0 && imported) {
+         query_hnd = imported;
+         have_ds = md_scalar(gr, query_hnd, SMT_DATASPACE, &dataspace, sizeof(dataspace));
+      }
+   }
+
+   if (have_ds) {
+      switch (dataspace & DS_STANDARD_MASK) {
+      case DS_STANDARD_BT709:
+         out->yuv_color_space = __DRI_YUV_COLOR_SPACE_ITU_REC709;
+         break;
+      case DS_STANDARD_BT2020:
+      case DS_STANDARD_BT2020_CL:
+         out->yuv_color_space = __DRI_YUV_COLOR_SPACE_ITU_REC2020;
+         break;
+      default:
+         break;
+      }
+
+      if ((dataspace & DS_RANGE_MASK) == DS_RANGE_FULL)
+         out->sample_range = __DRI_YUV_FULL_RANGE;
+   }
+
+   uint8_t buf[160];
+   int32_t n = md_fetch(gr, query_hnd, SMT_CHROMA_SITING, buf, sizeof(buf));
+   if (n > 0) {
+      struct md_reader r = {buf, buf + n, true};
+      if (md_header(&r, SMT_CHROMA_SITING)) {
+         md_skip_str(&r);
+         int64_t siting = md_i64(&r);
+         if (r.ok) {
+            switch (siting) {
+            case CHROMA_SITING_COSITED_HORIZONTAL:
+               out->horizontal_siting = __DRI_YUV_CHROMA_SITING_0;
+               break;
+            case CHROMA_SITING_COSITED_VERTICAL:
+               out->vertical_siting = __DRI_YUV_CHROMA_SITING_0;
+               break;
+            case CHROMA_SITING_COSITED_BOTH:
+               out->horizontal_siting = __DRI_YUV_CHROMA_SITING_0;
+               out->vertical_siting = __DRI_YUV_CHROMA_SITING_0;
+               break;
+            default:
+               break;
+            }
+         }
+      }
+   }
+
+   if (imported)
+      gr->mapper->v5.freeBuffer(imported);
+   return 0;
+}
+
+static int
+destroy(struct u_gralloc *gralloc)
+{
+   struct aimapper_gralloc *gr = (struct aimapper_gralloc *)gralloc;
+   FREE(gr);
+   return 0;
+}
+
+typedef void *(*sphal_load_fn)(const char *name, int flag);
+typedef int32_t (*load_imapper_fn)(AIMapper **outImplementation);
+
+static AIMapper *
+try_extract_mapper(void *lib)
+{
+   if (!lib)
+      return NULL;
+
+   load_imapper_fn fn = (load_imapper_fn)dlsym(lib, "AIMapper_loadIMapper");
+   if (!fn)
+      return NULL;
+
+   AIMapper *mapper = NULL;
+   if (fn(&mapper) != 0 || !mapper)
+      return NULL;
+
+   if (mapper->version < AIMAPPER_VERSION_5 || !mapper->v5.getStandardMetadata)
+      return NULL;
+
+   return mapper;
+}
+
+struct binder_mapper_list {
+   char names[16][128];
+   unsigned count;
+};
+
+static void
+collect_mapper_instance(const char *name, void *ctx)
+{
+   struct binder_mapper_list *list = (struct binder_mapper_list *)ctx;
+   if (!name || !name[0] || list->count >= ARRAY_SIZE(list->names))
+      return;
+   size_t len = strlen(name);
+   if (len >= sizeof(list->names[0]))
+      return;
+   memcpy(list->names[list->count], name, len + 1);
+   list->count++;
+}
+
+static void *
+load_mapper_via_binder(AIMapper **out_mapper)
+{
+   void *binder = dlopen("libbinder_ndk.so", RTLD_NOW | RTLD_LOCAL);
+   if (!binder)
+      return NULL;
+
+   typedef void (*visit_fn)(const char *, void *, void (*)(const char *, void *));
+   typedef void *(*open_fn)(const char *, const char *, int);
+   visit_fn visit = (visit_fn)dlsym(binder, "AServiceManager_forEachDeclaredInstance");
+   open_fn open_hal = (open_fn)dlsym(binder, "AServiceManager_openDeclaredPassthroughHal");
+   if (!visit || !open_hal) {
+      dlclose(binder);
+      return NULL;
+   }
+
+   struct binder_mapper_list list = {0};
+   visit("mapper", &list, collect_mapper_instance);
+
+   /* Prefer "default" first if declared, then try every remaining instance. */
+   for (int pass = 0; pass < 2; pass++) {
+      for (unsigned i = 0; i < list.count; i++) {
+         bool is_default = strcmp(list.names[i], "default") == 0;
+         if ((pass == 0) != is_default)
+            continue;
+
+         void *lib = open_hal("mapper", list.names[i], RTLD_NOLOAD | RTLD_NOW | RTLD_LOCAL);
+         if (!lib)
+            lib = open_hal("mapper", list.names[i], RTLD_NOW | RTLD_LOCAL);
+         AIMapper *mapper = try_extract_mapper(lib);
+         if (mapper) {
+            dlclose(binder);
+            *out_mapper = mapper;
+            return lib;
+         }
+      }
+   }
+
+   dlclose(binder);
+   return NULL;
+}
+
+static void *
+load_mapper_via_sphal(AIMapper **out_mapper)
+{
+   void *vndk = dlopen("libvndksupport.so", RTLD_NOW | RTLD_LOCAL);
+   if (!vndk)
+      return NULL;
+
+   sphal_load_fn sphal = (sphal_load_fn)dlsym(vndk, "android_load_sphal_library");
+   if (!sphal)
+      return NULL;
+
+   static const char *const dirs[] = {"/vendor/lib64/hw", "/vendor/lib/hw"};
+   for (unsigned d = 0; d < ARRAY_SIZE(dirs); d++) {
+      DIR *dir = opendir(dirs[d]);
+      if (!dir)
+         continue;
+
+      struct dirent *ent;
+      while ((ent = readdir(dir))) {
+         if (strncmp(ent->d_name, "mapper.", 7) != 0)
+            continue;
+         size_t len = strlen(ent->d_name);
+         if (len < 4 || strcmp(ent->d_name + len - 3, ".so") != 0)
+            continue;
+
+         void *lib = sphal(ent->d_name, RTLD_NOW);
+         AIMapper *mapper = try_extract_mapper(lib);
+         if (mapper) {
+            closedir(dir);
+            *out_mapper = mapper;
+            return lib;
+         }
+      }
+      closedir(dir);
+   }
